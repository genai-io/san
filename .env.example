# San - Environment Variables
# Copy this file to .env and fill in your API keys.
#
# A .env is read from the directory San is launched in, so it can supply
# credentials but never the endpoint they are sent to: names ending in
# _BASE_URL, the proxy variables and SSL_CERT_FILE/SSL_CERT_DIR are ignored
# here and San says so at startup. Otherwise a .env committed to a repository
# you cloned could point a provider somewhere else and take your key with it.
#
# To override a base URL, export it in your shell or set it from the provider
# menu — both are your own environment rather than the repository's.

# OpenAI API Key (for GPT-4, GPT-4o, etc.)
OPENAI_API_KEY=sk-xxx

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini API Key
GOOGLE_API_KEY=xxx

# BigModel (Zhipu GLM) API Key
BIGMODEL_API_KEY=xxx
# BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # optional override (export it; see the note at the top)

# DeepSeek API Key
DEEPSEEK_API_KEY=xxx

# Moonshot (Kimi) API Key
MOONSHOT_API_KEY=xxx

# Alibaba (Qwen/DashScope) API Key
DASHSCOPE_API_KEY=xxx

# MiniMax API Key
MINIMAX_API_KEY=xxx

# SenseNova API Key
SENSENOVA_API_KEY=xxx
# SENSENOVA_BASE_URL=   # optional override (export it; see the note at the top)

# Mimo API Key
MIMO_API_KEY=xxx
# MIMO_BASE_URL=   # optional override (export it; see the note at the top)

# Ollama (local models) — no key needed, just set the base URL if non-default
# OLLAMA_BASE_URL=http://localhost:11434/v1   # export it; see the note at the top

# Search providers
# TAVILY_API_KEY=xxx
# BRAVE_API_KEY=xxx
# SERPER_API_KEY=xxx
